# writer representation selection with the """( )""" raw syntax

# 7 quotes: raw wins (15 < 16), N=3
"""(""""""")"""
# 6a + 6q + ) + 3q: raw wins (26 < 27), N=4
""""(aaaaaa"""""")""")""""
# 7q + )): ends with ), raw wins (17 < 18), re-dispatch
"""(""""""")))"""
# space: quoted wins (6 < 11)
"a b"
# 6 quotes: tie 15 = 15, quoted wins
"\"\"\"a\"\"\""
# starts with quote: quoted wins (7 < 12)
"\"abc"
# ends with quote: quoted wins (7 < 12)
"abc\""
# two quotes: quoted wins (4 < 8)
"\"\""
# carriage return: quoted wins (6 < 11)
"a\rb"
# empty string: quoted wins (2 < 8)
""
# empty quoted followed by quoted: space needed in minimal
"a b"
# quoted followed by raw: no space needed in minimal
"a b"
# raw after non-empty quoted: butts directly
"""(""""""")"""
# unquoted with children
child{value}
# raw in input, writer switches to quoted
"""(it has """" quotes)"""
