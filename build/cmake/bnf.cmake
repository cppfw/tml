# ==============
# = tml-bnf    =
#
# An independent, spec-driven (BNF) parser for tml. It is used to cross-check
# the reference parser in libtml against the tml BNF (see doc/bnf.md).
# This is a development / testing aid, so it is not exported or installed.

if(IS_VCPKG_PORT_BUILD)
    return()
endif()

# tml-bnf is a development / testing aid that is only exercised by the bnf
# conformance test, so build it only on linux. this also avoids requiring
# bison on macos / windows / ios: the xcode generator runs custom commands in
# script phases with a minimal PATH in which only the ancient system bison is
# found, and bison is not pre-installed on the windows image.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    return()
endif()

set(bnf_src_dir ${CMAKE_CURRENT_LIST_DIR}/../../src/bnf)
set(bnf_bin_dir ${CMAKE_CURRENT_BINARY_DIR}/bnf)

# Generate the bison parser from tml.y.
add_custom_command(
    OUTPUT
        ${bnf_bin_dir}/tml_bnf.cc
    COMMAND
        ${CMAKE_COMMAND} -E make_directory ${bnf_bin_dir}
    COMMAND
        bison
        -o ${bnf_bin_dir}/tml_bnf.cc
        --defines=${bnf_bin_dir}/tml_bnf.hh
        ${bnf_src_dir}/tml.y
    DEPENDS
        ${bnf_src_dir}/tml.y
    BYPRODUCTS
        ${bnf_bin_dir}/tml_bnf.hh
        ${bnf_bin_dir}/stack.hh
    COMMENT
        "Generating tml_bnf.cc with bison"
)

set(bnf_srcs)
myci_add_source_files(bnf_srcs
    DIRECTORY
        ${bnf_src_dir}
    RECURSIVE
)
# the parser generated by bison
list(APPEND bnf_srcs ${bnf_bin_dir}/tml_bnf.cc)

myci_declare_library(tml-bnf
    NO_EXPORT
    SOURCES
        ${bnf_srcs}
    PUBLIC_INCLUDE_DIRECTORIES
        ${CMAKE_CURRENT_LIST_DIR}/../../src
    PRIVATE_INCLUDE_DIRECTORIES
        ${bnf_src_dir}
        ${bnf_bin_dir}
    DEPENDENCIES
        tml::tml
        utki
        fsif
)
set_target_properties(tml-bnf PROPERTIES SKIP_INSTALL TRUE)

# ================
# = bnf tests    =

set(bnf_tests_srcs)
myci_add_source_files(bnf_tests_srcs
    DIRECTORY
        ${CMAKE_CURRENT_LIST_DIR}/../../tests/bnf_conformance/src
    RECURSIVE
)
myci_declare_application(${PROJECT_NAME}-bnf-conformance
    SOURCES
        ${bnf_tests_srcs}
    DEPENDENCIES
        tml::tml
        tml::tml-bnf
        tst::tst
)

myci_declare_test(
    RUN_TARGET
        run-${PROJECT_NAME}-bnf-conformance
)
